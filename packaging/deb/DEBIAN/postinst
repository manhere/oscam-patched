#!/bin/sh
# OSCam .deb post-installation script.
set -e

case "$1" in
    configure)
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload >/dev/null 2>&1 || true
            systemctl enable oscam.service >/dev/null 2>&1 || true
            if systemctl is-active --quiet oscam.service; then
                systemctl restart oscam.service >/dev/null 2>&1 || true
            else
                systemctl start oscam.service >/dev/null 2>&1 || true
            fi
        fi
        ;;
esac

exit 0
